# Copy to .env or run a deploy script to generate local passwords automatically.
CLICKHOUSE_USER=fusion
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA

# Host bindings. Keep ingestion on localhost unless an isolated lab VM needs access.
FUSION_BIND_ADDRESS=127.0.0.1
FUSION_INGEST_PORT=8686
# Syslog is plaintext and unauthenticated. Keep this on localhost unless a
# source-restricted isolated lab interface is explicitly required.
FUSION_SYSLOG_BIND_ADDRESS=127.0.0.1
FUSION_SYSLOG_TCP_PORT=5514
FUSION_SYSLOG_UDP_PORT=5514
FUSION_VECTOR_API_PORT=8687
FUSION_GRAFANA_PORT=3000

# Detection engine safeguards. Rules and checkpoints remain repository/ClickHouse managed.
FUSION_DETECTION_POLL_SECONDS=10
FUSION_DETECTION_LOOKBACK_SECONDS=120
FUSION_DETECTION_BATCH_SIZE=1000
FUSION_DETECTION_LOG_LEVEL=INFO
