data_dir: '__FUSION_DATA_DIR__'

sources:
  sysmon:
    type: windows_event_log
    channels:
      - Microsoft-Windows-Sysmon/Operational
    only_event_ids:
      - 1
      - 3
      - 7
      - 11
      - 13
      - 22
    include_xml: true
    render_message: true
    read_existing_events: false
    checkpoint_interval_secs: 5
    batch_size: 100
    event_timeout_ms: 5000
    max_event_data_length: 0

  vector_internal_logs:
    type: internal_logs

transforms:
  # Sysmon records both the agent's outbound HTTP connection and, with Docker
  # Desktop port publishing, the host-side com.docker.backend.exe connection.
  # Forwarding either Event ID 3 back to the collector creates recursive
  # self-observation noise and can be mistaken for endpoint/IP ownership during
  # correlation. This conjunction is deliberately narrow: retain other
  # destinations, processes, ports, protocols and inbound observations.
  exclude_fusion_collector_feedback:
    type: filter
    inputs:
      - sysmon
    condition: |-
      event_id = to_int(.event_id) ?? to_int(.Event.System.EventID) ?? to_int(.winlog.event_id) ?? 0
      image = downcase(to_string(.event_data.Image) ?? to_string(.Event.EventData.Image) ?? to_string(.winlog.event_data.Image) ?? "")
      destination_ip = downcase(to_string(.event_data.DestinationIp) ?? to_string(.Event.EventData.DestinationIp) ?? to_string(.winlog.event_data.DestinationIp) ?? "")
      destination_port = to_int(.event_data.DestinationPort) ?? to_int(.Event.EventData.DestinationPort) ?? to_int(.winlog.event_data.DestinationPort) ?? 0
      initiated = downcase(to_string(.event_data.Initiated) ?? to_string(.Event.EventData.Initiated) ?? to_string(.winlog.event_data.Initiated) ?? "")
      protocol = downcase(to_string(.event_data.Protocol) ?? to_string(.Event.EventData.Protocol) ?? to_string(.winlog.event_data.Protocol) ?? "")
      collector_host = downcase(__FUSION_COLLECTOR_HOST__)
      is_fusion_agent = image == __FUSION_AGENT_BINARY__
      is_docker_desktop_ingress = image == __FUSION_DOCKER_DESKTOP_BINARY__
      is_fusion_transport = (is_fusion_agent && initiated == "true") || (is_docker_desktop_ingress && initiated == "false")
      is_collector_destination = destination_ip == collector_host
      !(event_id == 3 && is_fusion_transport && is_collector_destination && destination_port == __FUSION_COLLECTOR_PORT__ && protocol == "tcp")

sinks:
  fusion_collector:
    type: http
    inputs:
      - exclude_fusion_collector_feedback
    uri: '__FUSION_COLLECTOR_URL__'
    method: post
    compression: none
    framing:
      method: bytes
    encoding:
      codec: json
    batch:
      max_events: 1
      max_bytes: 1048576
      timeout_secs: 1
    buffer:
      type: disk
      max_size: 268435488
      when_full: block
    acknowledgements:
      enabled: true
    healthcheck:
      enabled: false
    request:
      retry_attempts: 10
      retry_initial_backoff_secs: 1
      retry_max_duration_secs: 30

  local_agent_logs:
    type: file
    inputs:
      - vector_internal_logs
    path: '__FUSION_LOG_DIR__\vector-%Y-%m-%d.log'
    encoding:
      codec: json
